{
	"name": "dataflow2",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"linkedService": {
						"referenceName": "fordatabricksexternal_ls",
						"type": "LinkedServiceReference"
					},
					"name": "transactions"
				},
				{
					"linkedService": {
						"referenceName": "fordatabricksexternal_ls",
						"type": "LinkedServiceReference"
					},
					"name": "cardtransactions"
				},
				{
					"linkedService": {
						"referenceName": "fordatabricksexternal_ls",
						"type": "LinkedServiceReference"
					},
					"name": "customers"
				},
				{
					"linkedService": {
						"referenceName": "fordatabricksexternal_ls",
						"type": "LinkedServiceReference"
					},
					"name": "cards"
				}
			],
			"sinks": [
				{
					"linkedService": {
						"referenceName": "fordatabricksexternal_ls",
						"type": "LinkedServiceReference"
					},
					"name": "sink1",
					"rejectedDataLinkedService": {
						"referenceName": "fordatabricksexternal_ls",
						"type": "LinkedServiceReference"
					}
				},
				{
					"linkedService": {
						"referenceName": "fordatabricksexternal_ls",
						"type": "LinkedServiceReference"
					},
					"name": "sink2"
				}
			],
			"transformations": [
				{
					"name": "custWithCards"
				},
				{
					"name": "filter1"
				},
				{
					"name": "RemoveColumns1",
					"description": "Autogenerated by data preview actions"
				},
				{
					"name": "customerTransactions"
				},
				{
					"name": "RemoveColumns2",
					"description": "Autogenerated by data preview actions"
				},
				{
					"name": "customerWithTransactions"
				},
				{
					"name": "aggregate1"
				},
				{
					"name": "aggregate2"
				},
				{
					"name": "sort1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          transaction_id as short,",
				"          account_id as integer,",
				"          txn_date as date,",
				"          txn_type as string,",
				"          amount as double,",
				"          channel as string,",
				"          merchant_category as string",
				"     ),",
				"     useSchema: false,",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     limit: 10000,",
				"     ignoreNoFilesFound: false,",
				"     format: 'delimited',",
				"     container: 'databricks-container',",
				"     folderPath: 'bank',",
				"     fileName: 'transactions.csv',",
				"     columnDelimiter: ',',",
				"     escapeChar: '\\\\',",
				"     quoteChar: '\\\"',",
				"     columnNamesAsHeader: true) ~> transactions",
				"source(output(",
				"          card_txn_id as short,",
				"          card_id as integer,",
				"          txn_date as date,",
				"          merchant_category as string,",
				"          amount as double,",
				"          is_fraud as boolean",
				"     ),",
				"     useSchema: false,",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     limit: 1000,",
				"     ignoreNoFilesFound: false,",
				"     format: 'delimited',",
				"     container: 'databricks-container',",
				"     folderPath: 'bank',",
				"     fileName: 'card_transactions.csv',",
				"     columnDelimiter: ',',",
				"     escapeChar: '\\\\',",
				"     quoteChar: '\\\"',",
				"     columnNamesAsHeader: true) ~> cardtransactions",
				"source(output(",
				"          customer_id as short,",
				"          name as string,",
				"          gender as string,",
				"          date_of_birth as date,",
				"          city as string,",
				"          state as string,",
				"          phone as long,",
				"          email as string,",
				"          occupation as string,",
				"          annual_income as integer,",
				"          join_date as date,",
				"          credit_score as short",
				"     ),",
				"     useSchema: false,",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     limit: 10000,",
				"     ignoreNoFilesFound: false,",
				"     format: 'delimited',",
				"     container: 'databricks-container',",
				"     folderPath: 'bank',",
				"     fileName: 'customers.csv',",
				"     columnDelimiter: ',',",
				"     escapeChar: '\\\\',",
				"     quoteChar: '\\\"',",
				"     columnNamesAsHeader: true) ~> customers",
				"source(output(",
				"          card_id as short,",
				"          customer_id as integer,",
				"          account_id as integer,",
				"          card_type as string,",
				"          issue_date as date,",
				"          expiry_date as date,",
				"          credit_limit as integer,",
				"          status as string",
				"     ),",
				"     useSchema: false,",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     limit: 10000,",
				"     ignoreNoFilesFound: false,",
				"     format: 'delimited',",
				"     container: 'databricks-container',",
				"     folderPath: 'bank',",
				"     fileName: 'cards.csv',",
				"     columnDelimiter: ',',",
				"     escapeChar: '\\\\',",
				"     quoteChar: '\\\"',",
				"     columnNamesAsHeader: true) ~> cards",
				"customers, cards join(customers@customer_id == cards@customer_id,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> custWithCards",
				"custWithCards filter(not(isNull(cards@customer_id))) ~> filter1",
				"filter1 select(mapColumn(",
				"          name,",
				"          gender,",
				"          date_of_birth,",
				"          city,",
				"          state,",
				"          occupation,",
				"          annual_income,",
				"          credit_score,",
				"          card_id,",
				"          customer_id,",
				"          account_id,",
				"          card_type,",
				"          credit_limit,",
				"          status",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> RemoveColumns1",
				"cardtransactions, RemoveColumns1 join(cardtransactions@card_id == RemoveColumns1@card_id,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> customerTransactions",
				"customerTransactions select(mapColumn(",
				"          card_txn_id,",
				"          txn_date,",
				"          merchant_category,",
				"          amount,",
				"          is_fraud,",
				"          gender,",
				"          city,",
				"          state,",
				"          occupation,",
				"          annual_income,",
				"          credit_score,",
				"          card_id,",
				"          card_type,",
				"          credit_limit,",
				"          status,",
				"          account_id,",
				"          each(match(name!='card_id'&&name!='name'&&name!='date_of_birth'&&name!='customer_id'&&name!='account_id'))",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> RemoveColumns2",
				"transactions, RemoveColumns1 join(transactions@account_id == RemoveColumns1@account_id,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> customerWithTransactions",
				"customerWithTransactions aggregate(groupBy(state,",
				"          txn_year = year(txn_date),",
				"          txn_month = month(txn_date)),",
				"     amount = sum(amount)) ~> aggregate1",
				"customerWithTransactions aggregate(groupBy(state),",
				"     total_amount = sum(amount),",
				"          no_of_people = count(transactions@account_id),",
				"          distinct_transactions = countDistinct(transaction_id, transactions@account_id)) ~> aggregate2",
				"aggregate2 sort(desc(total_amount, true)) ~> sort1",
				"aggregate1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'delimited',",
				"     container: 'adf-output',",
				"     folderPath: 'copied_files',",
				"     columnDelimiter: ',',",
				"     escapeChar: '\\\\',",
				"     quoteChar: '\\\"',",
				"     columnNamesAsHeader: true,",
				"     partitionFileNames:['state_level_reporting.csv'],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> sink1",
				"sort1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'delimited',",
				"     container: 'adf-output',",
				"     folderPath: 'copied_files',",
				"     columnDelimiter: ',',",
				"     escapeChar: '\\\\',",
				"     quoteChar: '\\\"',",
				"     columnNamesAsHeader: true,",
				"     partitionFileNames:['state_agg.csv'],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> sink2"
			]
		}
	}
}