{
	"name": "dataCleaning",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "SorceDataSet",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "TargetDataSet",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "filter1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          Prop_0 as string,",
				"          {Reg.No} as string,",
				"          Name as string,",
				"          {22CS205} as string,",
				"          {22CS206} as string,",
				"          {22CS207} as string,",
				"          {22CS208} as string,",
				"          {22CS952} as string,",
				"          {22SA202} as string,",
				"          {22TP203} as string,",
				"          {22TP204} as string,",
				"          {22CE851} as string,",
				"          {22BM851} as string,",
				"          {22FT851} as string,",
				"          {22CY951} as string,",
				"          {22NC901} as string,",
				"          {22AH901} as string,",
				"          {22CE906} as string,",
				"          {22SA906} as string,",
				"          {22MS911} as string,",
				"          {22CE853} as string,",
				"          {22BI851} as string,",
				"          {22SA901} as string,",
				"          {22AM951} as string,",
				"          {22TP852} as string,",
				"          {22MS906} as string,",
				"          {22EC858} as string,",
				"          {22MT855} as string,",
				"          {22RA853} as string,",
				"          {22TP908} as string,",
				"          {22EC903} as string,",
				"          {22MS901} as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 filter(!isNull({Reg.No})) ~> filter1",
				"filter1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> sink1"
			]
		}
	}
}